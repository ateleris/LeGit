{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeGit",
  "version": "1.0.3",
  "identifier": "ch.ateleris.legit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "LeGit",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "backgroundColor": "#1e1e1e",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.gravatar.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./templates/main.desktop"
      }
    },
    "category": "DeveloperTool",
    "licenseFile": "../LICENSE",
    "shortDescription": "A free, cross-platform Git GUI",
    "longDescription": "LeGit — community-driven Git GUI with first-class Linux support and colorblind-friendly theming.",
    "resources": {
      "../themes/*.legit-theme.json": "themes/"
    },
    "windows": {
      "wix": {
        "upgradeCode": "60af9dc1-85b5-5b4f-bdac-58610790074f"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2MTk4MTRFQTFFQzM5RkIKUldUN09leWhUb0VaeHNob3pCZmZaNmNlaExTU1QvVWRqM0haM3JQdU9EelZJajJNV3R1V0hkR0kK",
      "endpoints": [
        "https://github.com/ateleris/LeGit/releases/latest/download/latest.json"
      ]
    }
  }
}
