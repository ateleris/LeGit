{
  "$schema": "https://legit.dev/schemas/theme-v1.json",
  "format": "legit-theme",
  "formatVersion": 1,
  "name": "Dark",
  "author": "LeGit",
  "description": "Built-in dark theme. Danger and success palette entries are chosen orange/blue so that red-green colourblind users see the diff distinction by default.",
  "palette": {
    "accent": "#4a9eff",
    "accent-fg": "#ffffff",
    "console-bg": "#1a1a1a",
    "danger": "#e58e26",
    "input-bg": "#2d2d30",
    "main-bg": "#1e1e1e",
    "main-fg": "#e0e0e0",
    "panel-bg": "#252526",
    "panel-border": "#333333",
    "stderr-fg": "#e58e26",
    "subtle-fg": "#888888",
    "success": "#3498db",
    "warning": "#f1fa8c",
    "graph-lane-0": "#4C9BE8",
    "graph-lane-1": "#E8A04C",
    "graph-lane-2": "#4CE87A",
    "graph-lane-3": "#E84C9B",
    "graph-lane-4": "#9B4CE8",
    "graph-lane-5": "#4CE8E0",
    "graph-lane-fallback": "#888888",
    "status-added": "#3FB950",
    "status-modified": "#D29922",
    "status-deleted": "#F85149",
    "status-renamed": "#4C9BE8",
    "row-selected-bg": "#4a9eff33",
    "ref-branch-bg": "#50a0ff26",
    "ref-branch-border": "#50a0ff73",
    "ref-branch-fg": "#78b4ff",
    "ref-branch-current-bg": "#64c86433",
    "ref-branch-current-border": "#64c864b3",
    "ref-branch-current-fg": "#82dc82",
    "ref-remote-bg": "#aa82ff26",
    "ref-remote-border": "#aa82ff73",
    "ref-remote-fg": "#b996ff",
    "ref-tag-bg": "#dcaa3c26",
    "ref-tag-border": "#dcaa3c73",
    "ref-tag-fg": "#dcaa3c",
    "ref-head-bg": "#f064642e",
    "ref-head-border": "#f064648c",
    "ref-head-fg": "#f08282",
    "ref-stash-fg": "#5fd3c4",
    "accent-hover": "#6ab4ff",
    "danger-hover": "#f4a340",
    "ref-overflow-bg": "#ffffff14",
    "ref-overflow-border": "#ffffff40",
    "ref-other-bg": "#96969626",
    "ref-other-border": "#96969659",
    "diff-added-line": "#3498db33",
    "diff-removed-line": "#e58e2633",
    "diff-hunk-header": "#4a9eff24",
    "shadow": "#00000066"
  },
  "tokens": {
    "accent": "accent",
    "accent.fg": "accent-fg",
    "app.bg": "main-bg",
    "app.fg": "main-fg",
    "branch.current.fg": "accent",
    "button.active.bg": {
      "ref": "accent",
      "filter": "subtle"
    },
    "button.bg": "panel-bg",
    "button.danger.bg": "danger",
    "button.danger.fg": "main-bg",
    "button.danger.hover.bg": "danger-hover",
    "button.fg": "main-fg",
    "button.hover.bg": "input-bg",
    "button.primary.bg": "accent",
    "button.primary.fg": "accent-fg",
    "button.primary.hover.bg": "accent-hover",
    "commit.signed.indicator": "success",
    "console.bg": "console-bg",
    "console.fg": "main-fg",
    "console.prompt.fg": "accent",
    "console.stderr.fg": "stderr-fg",
    "console.stdout.fg": "main-fg",
    "diff.action.bg": "panel-bg",
    "diff.action.fg": "main-fg",
    "diff.action.hover.bg": "input-bg",
    "diff.action.hover.fg": "main-fg",
    "diff.added.bg": "diff-added-line",
    "diff.added.fg": "main-fg",
    "diff.added.word.bg": "success",
    "diff.discard.bg": "danger",
    "diff.discard.fg": "main-bg",
    "diff.discard.hover.bg": "danger-hover",
    "diff.discard.hover.fg": "main-bg",
    "diff.gutter.bg": "panel-bg",
    "diff.gutter.fg": "subtle-fg",
    "diff.hunk.header.bg": "diff-hunk-header",
    "diff.hunk.header.fg": "subtle-fg",
    "diff.line.selected.bg": "row-selected-bg",
    "diff.removed.bg": "diff-removed-line",
    "diff.removed.fg": "main-fg",
    "diff.removed.word.bg": "danger",
    "divider.bg": "panel-border",
    "divider.hover.bg": "accent",
    "dnd.overlay.bg": "row-selected-bg",
    "error.fg": "danger",
    "graph.lane.0": "graph-lane-0",
    "graph.lane.1": "graph-lane-1",
    "graph.lane.2": "graph-lane-2",
    "graph.lane.3": "graph-lane-3",
    "graph.lane.4": "graph-lane-4",
    "graph.lane.5": "graph-lane-5",
    "graph.lane.fallback": "graph-lane-fallback",
    "graph.row.hover.bg": {
      "ref": "row-selected-bg",
      "filter": "faded"
    },
    "graph.row.selected.bg": "row-selected-bg",
    "input.bg": "input-bg",
    "input.border": "panel-border",
    "input.fg": "main-fg",
    "input.focus.border": "accent",
    "menu.hover.bg": {
      "ref": "accent",
      "filter": "subtle"
    },
    "pane.header.bg": "panel-bg",
    "pane.header.border": "panel-border",
    "pane.header.fg": "subtle-fg",
    "panel-tab.active.bg": "input-bg",
    "panel-tab.active.fg": "main-fg",
    "panel-tab.bg": "panel-bg",
    "panel-tab.border": "panel-border",
    "panel-tab.fg": "subtle-fg",
    "panel.bg": "panel-bg",
    "panel.border": "panel-border",
    "panel.border.drag": "accent",
    "panel.fg": "main-fg",
    "panel.header.bg": "panel-bg",
    "panel.header.fg": "main-fg",
    "progress.bar.bg": "accent",
    "ref.branch.bg": "ref-branch-bg",
    "ref.branch.border": "ref-branch-border",
    "ref.branch.current.bg": "ref-branch-current-bg",
    "ref.branch.current.border": "ref-branch-current-border",
    "ref.branch.current.fg": "ref-branch-current-fg",
    "ref.branch.fg": "ref-branch-fg",
    "ref.head.bg": "ref-head-bg",
    "ref.head.border": "ref-head-border",
    "ref.head.fg": "ref-head-fg",
    "ref.other.bg": "ref-other-bg",
    "ref.other.border": "ref-other-border",
    "ref.other.fg": "subtle-fg",
    "ref.overflow.bg": "ref-overflow-bg",
    "ref.overflow.border": "ref-overflow-border",
    "ref.overflow.fg": "subtle-fg",
    "ref.remote.bg": "ref-remote-bg",
    "ref.remote.border": "ref-remote-border",
    "ref.remote.fg": "ref-remote-fg",
    "ref.stash.fg": "ref-stash-fg",
    "ref.tag.bg": "ref-tag-bg",
    "ref.tag.border": "ref-tag-border",
    "ref.tag.fg": "ref-tag-fg",
    "scrollbar.thumb": "panel-border",
    "scrollbar.thumb.hover": "subtle-fg",
    "scrollbar.track": "main-bg",
    "shadow.color": "shadow",
    "status.added": "status-added",
    "status.conflicted": "status-deleted",
    "status.copied": "status-renamed",
    "status.deleted": "status-deleted",
    "status.modified": "status-modified",
    "status.renamed": "status-renamed",
    "subtle.fg": "subtle-fg",
    "success.fg": "success",
    "tab.active.bg": "accent",
    "tab.active.fg": "accent-fg",
    "tab.bg": "panel-bg",
    "tab.border": "panel-border",
    "tab.fg": "subtle-fg",
    "tab.strip.bg": "panel-bg",
    "warning.fg": "warning"
  }
}
