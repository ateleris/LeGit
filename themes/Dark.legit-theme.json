{
  "$schema": "https://legit.dev/schemas/theme-v1.json",
  "format": "legit-theme",
  "formatVersion": 1,
  "name": "Dark",
  "author": "LeGit",
  "description": "Built-in dark theme. Danger and success palette entries are chosen orange/blue so that red-green colourblind users see the diff distinction by default.",
  "palette": {
    "accent": "#4a9eff",
    "accent-fg": "#ffffff",
    "console-bg": "#1a1a1a",
    "ansi-black": "#000000",
    "ansi-red": "#cd3131",
    "ansi-green": "#0dbc79",
    "ansi-yellow": "#e5e510",
    "ansi-blue": "#2472c8",
    "ansi-magenta": "#bc3fbc",
    "ansi-cyan": "#11a8cd",
    "ansi-white": "#e5e5e5",
    "ansi-bright-black": "#666666",
    "ansi-bright-red": "#f14c4c",
    "ansi-bright-green": "#23d18b",
    "ansi-bright-yellow": "#f5f543",
    "ansi-bright-blue": "#3b8eea",
    "ansi-bright-magenta": "#d670d6",
    "ansi-bright-cyan": "#29b8db",
    "ansi-bright-white": "#ffffff",
    "danger": "#e58e26",
    "input-bg": "#2d2d30",
    "main-bg": "#1e1e1e",
    "main-fg": "#e0e0e0",
    "panel-bg": "#252526",
    "panel-border": "#333333",
    "stderr-fg": "#e58e26",
    "subtle-fg": "#888888",
