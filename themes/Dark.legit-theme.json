    "danger-hover": "#f4a340",
    "ref-overflow-bg": "#ffffff14",
    "ref-overflow-border": "#ffffff40",
    "ref-other-bg": "#96969626",
    "ref-other-border": "#96969659",
    "diff-added-line": "#3498db33",
    "diff-removed-line": "#e58e2633",
    "diff-hunk-header": "#4a9eff24",
    "syn-keyword": "#569cd6",
    "syn-string": "#ce9178",
    "syn-number": "#b5cea8",
    "syn-comment": "#6a9955",
    "syn-function": "#dcdcaa",
    "syn-type": "#4ec9b0",
    "syn-variable": "#9cdcfe",
    "syn-property": "#9cdcfe",
    "syn-operator": "#d4d4d4",
    "syn-punctuation": "#909090",
    "syn-constant": "#4fc1ff",
    "syn-tag": "#569cd6",
    "shadow": "#00000066",
    "merge-fold": "#9aa0a626"
