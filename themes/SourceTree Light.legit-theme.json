    "ref-head-fg": "#de350b",
    "ref-stash-fg": "#00838f",
    "accent-hover": "#0065ff",
    "danger-hover": "#bf2600",
    "ref-overflow-bg": "#00000010",
    "ref-overflow-border": "#00000038",
    "ref-other-bg": "#6b778c26",
    "ref-other-border": "#6b778c59",
    "diff-added-line": "#e3fcef",
    "diff-removed-line": "#ffebe6",
    "diff-added-word": "#abf5d1",
    "diff-removed-word": "#ffbdad",
    "diff-hunk-header": "#deebff",
    "syn-keyword": "#0000ff",
    "syn-string": "#a31515",
    "syn-number": "#098658",
    "syn-comment": "#008000",
    "syn-function": "#795e26",
    "syn-type": "#267f99",
    "syn-variable": "#001080",
    "syn-property": "#001080",
    "syn-operator": "#383838",
    "syn-punctuation": "#6e6e6e",
    "syn-constant": "#0070c1",
    "syn-tag": "#800000",
    "shadow": "#00000040",
    "merge-fold": "#6b778c24"
