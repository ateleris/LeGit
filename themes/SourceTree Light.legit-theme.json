{
  "$schema": "https://legit.dev/schemas/theme-v1.json",
  "format": "legit-theme",
  "formatVersion": 1,
  "name": "SourceTree Light",
  "author": "LeGit",
  "description": "Built-in light theme styled after Atlassian SourceTree: white content, navy text, Atlassian blue accents and classic pale green/red diff colours (not colourblind-adjusted; use Light for that).",
  "palette": {
    "accent": "#0052cc",
    "accent-fg": "#ffffff",
    "console-bg": "#f4f5f7",
    "ansi-black": "#000000",
    "ansi-red": "#cd3131",
    "ansi-green": "#107c10",
    "ansi-yellow": "#949800",
    "ansi-blue": "#0451a5",
    "ansi-magenta": "#bc05bc",
    "ansi-cyan": "#0598bc",
    "ansi-white": "#555555",
    "ansi-bright-black": "#666666",
    "ansi-bright-red": "#cd3131",
    "ansi-bright-green": "#14ce14",
    "ansi-bright-yellow": "#b5ba00",
    "ansi-bright-blue": "#0451a5",
    "ansi-bright-magenta": "#bc05bc",
    "ansi-bright-cyan": "#0598bc",
    "ansi-bright-white": "#a5a5a5",
    "danger": "#de350b",
    "input-bg": "#fafbfc",
    "main-bg": "#ffffff",
    "main-fg": "#172b4d",
    "panel-bg": "#f4f5f7",
    "panel-border": "#dfe1e6",
    "stderr-fg": "#de350b",
    "subtle-fg": "#6b778c",
    "success": "#00875a",
    "warning": "#b45309",
