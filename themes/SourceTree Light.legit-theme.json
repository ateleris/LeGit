    "graph-lane-2": "#43a047",
    "graph-lane-3": "#fb8c00",
    "graph-lane-4": "#8e24aa",
    "graph-lane-5": "#00acc1",
    "graph-lane-fallback": "#6b778c",
    "status-added": "#00875a",
    "status-modified": "#b45309",
    "status-deleted": "#de350b",
    "status-renamed": "#0052cc",
    "row-selected-bg": "#0052cc26",
    "ref-branch-bg": "#0052cc1f",
    "ref-branch-border": "#0052cc66",
    "ref-branch-fg": "#0052cc",
    "ref-branch-current-bg": "#00875a1f",
    "ref-branch-current-border": "#00875a66",
    "ref-branch-current-fg": "#00875a",
    "ref-remote-bg": "#6554c01f",
