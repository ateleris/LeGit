{
  "$schema": "https://legit.dev/schemas/theme-v1.json",
  "format": "legit-theme",
  "formatVersion": 1,
  "name": "Git Terminal",
  "author": "LeGit",
  "description": "A tribute to git in a plain terminal: pure black, the classic xterm ANSI palette, and git's default colour semantics — green added, red removed, yellow tags, cyan hunk headers, magenta stashes. Deliberately red/green (git's own defaults), so not colourblind-safe by design.",
  "palette": {
    "accent": "#00cd00",
    "accent-fg": "#000000",
    "console-bg": "#000000",
    "ansi-black": "#000000",
    "ansi-red": "#cd0000",
    "ansi-green": "#00cd00",
    "ansi-yellow": "#cdcd00",
    "ansi-blue": "#0000ee",
    "ansi-magenta": "#cd00cd",
    "ansi-cyan": "#00cdcd",
    "ansi-white": "#e5e5e5",
    "ansi-bright-black": "#7f7f7f",
    "ansi-bright-red": "#ff0000",
    "ansi-bright-green": "#00ff00",
    "ansi-bright-yellow": "#ffff00",
    "ansi-bright-blue": "#5c5cff",
    "ansi-bright-magenta": "#ff00ff",
    "ansi-bright-cyan": "#00ffff",
    "ansi-bright-white": "#ffffff",
    "danger": "#ff0000",
    "input-bg": "#1a1a1a",
    "main-bg": "#000000",
    "main-fg": "#e5e5e5",
    "panel-bg": "#000000",
    "panel-border": "#333333",
    "stderr-fg": "#ff0000",
    "subtle-fg": "#7f7f7f",
    "success": "#00cd00",
    "warning": "#cdcd00",
    "graph-lane-0": "#00cd00",
    "graph-lane-1": "#ff0000",
    "graph-lane-2": "#cdcd00",
    "graph-lane-3": "#00cdcd",
    "graph-lane-4": "#ff00ff",
    "graph-lane-5": "#5c5cff",
    "graph-lane-fallback": "#7f7f7f",
    "status-added": "#00cd00",
    "status-modified": "#cdcd00",
    "status-deleted": "#ff0000",
    "status-renamed": "#00cdcd",
    "row-selected-bg": "#ffffff29",
    "ref-branch-bg": "#00cd0026",
    "ref-branch-border": "#00cd0073",
    "ref-branch-fg": "#00cd00",
    "ref-branch-current-bg": "#00ff0033",
    "ref-branch-current-border": "#00ff00b3",
    "ref-branch-current-fg": "#00ff00",
    "ref-remote-bg": "#cd000026",
    "ref-remote-border": "#ff000073",
    "ref-remote-fg": "#ff0000",
    "ref-tag-bg": "#cdcd0026",
    "ref-tag-border": "#cdcd0073",
    "ref-tag-fg": "#cdcd00",
    "ref-head-bg": "#00cdcd2e",
    "ref-head-border": "#00cdcd8c",
    "ref-head-fg": "#00cdcd",
    "ref-stash-fg": "#ff00ff",
    "accent-hover": "#00ff00",
    "danger-hover": "#ff5555",
    "ref-overflow-bg": "#ffffff14",
    "ref-overflow-border": "#ffffff40",
    "ref-other-bg": "#7f7f7f26",
    "ref-other-border": "#7f7f7f59",
    "diff-added-line": "#00cd0033",
    "diff-added-word": "#00cd0059",
    "diff-removed-line": "#cd000040",
    "diff-removed-word": "#cd000073",
    "diff-hunk-header": "#00cdcd1f",
    "syn-keyword": "#cdcd00",
    "syn-string": "#ff00ff",
    "syn-number": "#ff00ff",
    "syn-comment": "#7f7f7f",
    "syn-function": "#00ff00",
    "syn-type": "#00cd00",
    "syn-variable": "#e5e5e5",
    "syn-property": "#00cdcd",
    "syn-operator": "#e5e5e5",
    "syn-punctuation": "#7f7f7f",
    "syn-constant": "#ff0000",
    "syn-tag": "#cdcd00",
    "shadow": "#000000a6",
    "merge-fold": "#7f7f7f26"
  },
  "tokens": {
    "accent": "accent",
    "accent.fg": "accent-fg",
    "app.bg": "main-bg",
    "app.fg": "main-fg",
    "button.active.bg": {
      "ref": "accent",
      "filter": "subtle"
    },
    "button.bg": "input-bg",
    "button.danger.bg": "danger",
    "button.danger.fg": "main-bg",
    "button.danger.hover.bg": "danger-hover",
    "button.fg": "main-fg",
    "button.hover.bg": "panel-border",
    "button.primary.bg": "accent",
    "button.primary.fg": "accent-fg",
    "button.primary.hover.bg": "accent-hover",
    "console.bg": "console-bg",
    "console.fg": "main-fg",
    "console.prompt.fg": "accent",
    "console.stderr.fg": "stderr-fg",
    "console.stdout.fg": "main-fg",
    "console.ansi.black": "ansi-black",
    "console.ansi.red": "ansi-red",
    "console.ansi.green": "ansi-green",
    "console.ansi.yellow": "ansi-yellow",
    "console.ansi.blue": "ansi-blue",
    "console.ansi.magenta": "ansi-magenta",
    "console.ansi.cyan": "ansi-cyan",
    "console.ansi.white": "ansi-white",
    "console.ansi.bright.black": "ansi-bright-black",
    "console.ansi.bright.red": "ansi-bright-red",
    "console.ansi.bright.green": "ansi-bright-green",
    "console.ansi.bright.yellow": "ansi-bright-yellow",
    "console.ansi.bright.blue": "ansi-bright-blue",
    "console.ansi.bright.magenta": "ansi-bright-magenta",
    "console.ansi.bright.cyan": "ansi-bright-cyan",
    "console.ansi.bright.white": "ansi-bright-white",
    "diff.action.bg": "input-bg",
    "diff.action.fg": "main-fg",
    "diff.action.hover.bg": "panel-border",
    "diff.action.hover.fg": "main-fg",
    "diff.added.bg": "diff-added-line",
    "diff.added.fg": "main-fg",
    "diff.added.word.bg": "diff-added-word",
    "diff.discard.bg": "danger",
    "diff.discard.fg": "main-bg",
    "diff.discard.hover.bg": "danger-hover",
    "diff.discard.hover.fg": "main-bg",
    "diff.gutter.bg": "panel-bg",
    "diff.gutter.fg": "subtle-fg",
    "diff.hunk.header.bg": "diff-hunk-header",
    "diff.hunk.header.fg": "ansi-cyan",
    "blame.alt.bg": "input-bg",
    "diff.edited.bg": "diff-hunk-header",
    "banner.op.bg": "diff-hunk-header",
    "banner.op.fg": "main-fg",
    "banner.warning.bg": "diff-hunk-header",
    "banner.warning.fg": "warning",
    "diff.removed.bg": "diff-removed-line",
    "diff.removed.fg": "main-fg",
    "diff.removed.word.bg": "diff-removed-word",
    "divider.bg": "panel-border",
    "divider.hover.bg": "accent",
    "dnd.overlay.bg": "row-selected-bg",
    "error.fg": "danger",
    "graph.lane.0": "graph-lane-0",
    "graph.lane.1": "graph-lane-1",
    "graph.lane.2": "graph-lane-2",
    "graph.lane.3": "graph-lane-3",
    "graph.lane.4": "graph-lane-4",
    "graph.lane.5": "graph-lane-5",
    "graph.lane.fallback": "graph-lane-fallback",
    "graph.row.focused.bg": {
      "ref": "row-selected-bg",
      "filter": "faded"
    },
    "graph.row.hover.bg": {
      "ref": "row-selected-bg",
      "filter": "faded"
    },
    "graph.row.selected.bg": "row-selected-bg",
    "input.bg": "input-bg",
    "input.border": "panel-border",
    "input.fg": "main-fg",
    "input.focus.border": "accent",
    "menu.hover.bg": {
      "ref": "accent",
      "filter": "subtle"
    },
    "pane.header.bg": "panel-bg",
    "pane.header.border": "panel-border",
    "pane.header.fg": "subtle-fg",
    "preview.checker.a": "input-bg",
    "preview.checker.b": "panel-border",
    "panel.tab.active.bg": "input-bg",
    "panel.tab.active.fg": "main-fg",
    "panel.tab.bg": "panel-bg",
    "panel.tab.fg": "subtle-fg",
    "panel.bg": "panel-bg",
    "panel.border": "panel-border",
    "panel.border.drag": "accent",
    "panel.fg": "main-fg",
    "panel.header.bg": "panel-bg",
    "panel.header.fg": "main-fg",
    "progress.bar.bg": "accent",
    "ref.branch.bg": "ref-branch-bg",
    "ref.branch.border": "ref-branch-border",
    "ref.branch.current.bg": "ref-branch-current-bg",
    "ref.branch.current.border": "ref-branch-current-border",
    "ref.branch.current.fg": "ref-branch-current-fg",
    "ref.branch.fg": "ref-branch-fg",
    "ref.head.bg": "ref-head-bg",
    "ref.head.border": "ref-head-border",
    "ref.head.fg": "ref-head-fg",
    "ref.other.bg": "ref-other-bg",
    "ref.other.border": "ref-other-border",
    "ref.other.fg": "subtle-fg",
    "ref.overflow.bg": "ref-overflow-bg",
    "ref.overflow.border": "ref-overflow-border",
    "ref.overflow.fg": "subtle-fg",
    "ref.remote.bg": "ref-remote-bg",
    "ref.remote.border": "ref-remote-border",
    "ref.remote.fg": "ref-remote-fg",
    "ref.stash.fg": "ref-stash-fg",
    "ref.tag.bg": "ref-tag-bg",
    "ref.tag.border": "ref-tag-border",
    "ref.tag.fg": "ref-tag-fg",
    "scrollbar.thumb": "panel-border",
    "scrollbar.thumb.hover": "subtle-fg",
    "scrollbar.track": "main-bg",
    "shadow.color": "shadow",
    "status.added": "status-added",
    "status.conflicted": "status-deleted",
    "status.copied": "status-renamed",
    "status.deleted": "status-deleted",
    "status.modified": "status-modified",
    "status.renamed": "status-renamed",
    "subtle.fg": "subtle-fg",
    "success.fg": "success",
    "syntax.keyword": "syn-keyword",
    "syntax.string": "syn-string",
    "syntax.number": "syn-number",
    "syntax.comment": "syn-comment",
    "syntax.function": "syn-function",
    "syntax.type": "syn-type",
    "syntax.variable": "syn-variable",
    "syntax.property": "syn-property",
    "syntax.operator": "syn-operator",
    "syntax.punctuation": "syn-punctuation",
    "syntax.constant": "syn-constant",
    "syntax.tag": "syn-tag",
    "tab.active.bg": "accent",
    "tab.active.fg": "accent-fg",
    "tab.bg": "panel-bg",
    "tab.border": "panel-border",
    "tab.fg": "subtle-fg",
    "warning.fg": "warning",
    "merge.fold.bg": "merge-fold",
    "merge.fold.fg": "subtle-fg",
    "tab.strip.bg": "panel-bg"
  }
}
